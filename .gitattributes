# Git LFS tracking for large binary files
# GameMaker static libraries (60-116MB each)
*.a filter=lfs diff=lfs merge=lfs -text

# Game data files (up to ~200MB each)
*.droid filter=lfs diff=lfs merge=lfs -text

# Audio group data files
audiogroup*.dat filter=lfs diff=lfs merge=lfs -text
audio*roup*.dat filter=lfs diff=lfs merge=lfs -text

# Audio assets
*.ogg filter=lfs diff=lfs merge=lfs -text

# Video assets
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Ensure text files use LF line endings on checkout
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.pbxproj text eol=lf
*.plist text eol=lf
*.md text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
